  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "src",
    "LICENSE"
  ],
  "bin": {
    "bb-database": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "browser": "./dist/index.browser.js",
