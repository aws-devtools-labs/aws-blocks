{
  "name": "aws-cdk-blocks",
  "version": "1.0.0",
  "keywords": [
    "aws-blocks",
    "framework",
    "fullstack",
    "backend",
    "typescript",
    "serverless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aws/cdk-blocks.git",
    "directory": "packages/blocks"
  },
  "homepage": "https://github.com/aws/cdk-blocks/tree/main/packages/blocks#readme",
  "bugs": {
    "url": "https://github.com/aws/cdk-blocks/issues"
  },
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "blocks-generate-client": "./dist/generate-client-cli.js",
    "blocks-vendorize": "./dist/vendorize.js"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "README.md",
    "IMPORTS.md",
    "TROUBLESHOOTING.md",
    "MIGRATING-FROM-SCRIPTS.md",
    "VPC.md",
    "VPC-DESIGN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "browser": "./dist/index.browser.js",
      "cdk": "./dist/index.cdk.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cdk": {
      "types": "./dist/index.cdk.d.ts",
      "default": "./dist/index.cdk.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./lambda-handler": "./dist/lambda-handler.js",
    "./scripts": "./dist/scripts.js",
    "./run": "./dist/cli/run.js",
    "./vendorize": "./dist/vendorize.js",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "prebuild": "node ../../scripts/gen-block-docs.mjs",
    "prepack": "node ../../scripts/gen-block-docs.mjs",
    "build": "tsc --build",
    "test": "node --test dist/conditional-exports.test.js dist/mock-aws-parity.test.js dist/vendorize-map.test.js dist/ui.test.js dist/brand-coverage.test.js dist/sandbox-dir-coverage.test.js dist/sandbox-url-decoupling.test.js dist/branded-message-coverage.test.js dist/default-compute-telemetry.test.js dist/file-bucket-exports.test.js dist/readme-links.test.js dist/test-client.test.js dist/umbrella-browser-exports.test.js dist/totp.test.js dist/utils-exports.test.js dist/docs-pointers.test.js dist/doc-snippets.test.js dist/imports-reference.test.js dist/cli/*.test.js && node --conditions=cdk --test dist/umbrella-compute.test.js"
  },
  "dependencies": {
    "@aws-cdk-blocks/core": "^1.0.0",
    "@aws-cdk-blocks/hosting": "^1.0.0",
    "@aws-cdk-blocks/auth-common": "^1.0.0",
    "@aws-cdk-blocks/bb-auth": "^1.0.0",
    "@aws-cdk-blocks/bb-kv-store": "^1.0.0",
    "@aws-cdk-blocks/bb-realtime": "^1.0.0",
    "@aws-cdk-blocks/bb-database": "^1.0.0",
    "@aws-cdk-blocks/bb-async-job": "^1.0.0",
    "@aws-cdk-blocks/bb-cron-job": "^1.0.0",
    "@aws-cdk-blocks/bb-file-bucket": "^1.0.0",
    "@aws-cdk-blocks/bb-app-setting": "^1.0.0",
    "@aws-cdk-blocks/bb-secret": "^1.0.0",
    "@aws-cdk-blocks/bb-knowledge-base": "^1.0.0",
    "@aws-cdk-blocks/bb-agent": "^1.0.0",
    "@aws-cdk-blocks/bb-tracer": "^1.0.0",
    "@aws-cdk-blocks/bb-logger": "^1.0.0",
    "@aws-cdk-blocks/bb-email-client": "^1.0.0",
    "@aws-cdk-blocks/bb-metrics": "^1.0.0",
    "@aws-cdk-blocks/bb-dashboard": "^1.0.0",
    "@aws-cdk-blocks/bb-lambda-compute": "^1.0.0",
    "@aws-cdk-blocks/bb-container-compute": "^1.0.0",
    "@aws-cdk-blocks/bb-compute": "^1.0.0",
    "tsx": "^4.23.15"
  },
  "aws-blocks": {
    "vendorize": {
      "@aws-cdk-blocks/bb-kv-store": [
        "KVStore"
      ],
      "@aws-cdk-blocks/bb-realtime": [
        "Realtime"
      ],
      "@aws-cdk-blocks/bb-database": [
        "Database"
      ],
      "@aws-cdk-blocks/bb-async-job": [
        "AsyncJob"
      ],
      "@aws-cdk-blocks/bb-compute": [
        "Compute"
      ],
      "@aws-cdk-blocks/bb-cron-job": [
        "CronJob"
      ],
      "@aws-cdk-blocks/bb-file-bucket": [
        "FileBucket"
      ],
      "@aws-cdk-blocks/bb-app-setting": [
        "AppSetting"
      ],
      "@aws-cdk-blocks/bb-secret": [
        "Secret"
      ],
      "@aws-cdk-blocks/bb-knowledge-base": [
        "KnowledgeBase"
      ],
      "@aws-cdk-blocks/bb-auth": [
        "Auth"
      ],
      "@aws-cdk-blocks/bb-agent": [
        "Agent"
      ],
      "@aws-cdk-blocks/bb-tracer": [
        "Tracer"
      ],
      "@aws-cdk-blocks/bb-logger": [
        "Logger"
      ],
      "@aws-cdk-blocks/bb-email-client": [
        "EmailClient"
      ],
      "@aws-cdk-blocks/bb-metrics": [
        "Metrics"
      ],
      "@aws-cdk-blocks/bb-dashboard": [
        "Dashboard"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
