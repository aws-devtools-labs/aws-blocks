{
  "name": "@aws-cdk-blocks/bb-kv-store",
  "version": "1.0.0",
  "keywords": [
    "aws-blocks",
    "key-value",
    "document",
    "dynamodb",
    "nosql",
    "storage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aws/cdk-blocks.git",
    "directory": "packages/bb-kv-store"
  },
  "homepage": "https://github.com/aws/cdk-blocks/tree/main/packages/bb-kv-store#readme",
  "bugs": {
    "url": "https://github.com/aws/cdk-blocks/issues"
  },
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "browser": "./dist/index.browser.js",
      "cdk": {
        "types": "./dist/index.cdk.d.ts",
        "default": "./dist/index.cdk.js"
      },
      "aws-runtime": "./dist/index.aws.js",
      "types": "./dist/index.mock.d.ts",
      "default": "./dist/index.mock.js"
    }
  },
  "scripts": {
    "prebuild": "node ../../scripts/generate-version.mjs KVStore && node scripts/generate-readme-test.mjs",
    "build": "tsc --build && npm run build:lambda",
    "build:lambda": "esbuild src/gsi-manager-lambda.ts --bundle --platform=node --target=node24 --conditions=aws-runtime --outfile=dist/gsi-manager-lambda/index.js --format=cjs --external:@aws-sdk/*",
    "test": "node --test --test-concurrency=1 dist/index.test.js dist/parity.test.js dist/item-size.test.js dist/ttl.test.js dist/mock-file.test.js dist/types.test.js dist/readme.generated.test.js dist/user-agent.test.js dist/index.cdk.test.js dist/gsi-manager-lambda.test.js dist/legacy/runtime.test.js dist/legacy/cdk.test.js"
  },
  "dependencies": {
    "@aws-cdk-blocks/core": "^1.0.0",
    "@aws-cdk-blocks/bb-logger": "^1.0.0",
    "@aws-sdk/client-cloudformation": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@standard-schema/spec": "^1.1.0",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.6.0"
  }
}
