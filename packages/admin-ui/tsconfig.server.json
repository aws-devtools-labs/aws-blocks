{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/contract/**/*",
    "src/server/**/*",
    "src/theme/**/*",
    "src/nav/**/*",
    "src/env/**/*",
    "src/deployments/**/*",
    "src/usage/**/*",
    "src/settings/**/*"
  ]
}
