{
  "name": "@aws-blocks/nextjs",
  "version": "0.1.0",
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "description": "Next.js integration for AWS Blocks — wraps next.config so blocks work in Server Components, Server Actions, and route handlers",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "test": "node --test dist/**/*.test.js",
    "dev": "tsc --build --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "next": "^16.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@aws-blocks/bb-data": ">=0.2.0",
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-blocks/bb-data": {
      "optional": true
    }
  }
}
