{
  "name": "@aws-blocks/cli",
  "version": "0.1.0",
  "description": "Standalone command-line interface for AWS Blocks — the `blocks` bin.",
  "keywords": [
    "aws-blocks",
    "cli",
    "framework",
    "typescript",
    "backend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aws-devtools-labs/aws-blocks.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/aws-devtools-labs/aws-blocks/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/aws-devtools-labs/aws-blocks/issues"
  },
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "blocks": "./dist/blocks.js"
  },
  "files": [
    "dist",
    "README.md",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test dist/*.test.js dist/**/*.test.js",
    "dev": "tsc --build --watch"
  },
  "dependencies": {
    "@aws-blocks/blocks": "^0.6.0",
    "@aws-blocks/core": "^0.5.0",
    "@aws-blocks/hosting": "^0.3.1",
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "cross-spawn": "^7.0.6",
    "http-proxy": "^1.18.1",
    "typescript": "^5.3.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.33"
  }
}
