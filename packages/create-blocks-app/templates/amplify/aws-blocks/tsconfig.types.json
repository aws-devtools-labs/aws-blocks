{
  // Backend-only settings for the declaration files in .types/, which the
  // frontend's `import ... from 'aws-blocks'` reads (package.json exports
  // "types"). Generated by `blocks-generate-client` and the dev server, so the
  // frontend never typechecks this folder's source with its own tsconfig.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".types"
  },
  "files": ["index.ts"]
}
