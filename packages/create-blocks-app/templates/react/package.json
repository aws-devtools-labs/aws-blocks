{
  "name": "blocks-react-app",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "react",
  "blocksTemplateDescription": "Vite + React 19 frontend with auth, DynamoDB, and realtime todo app",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch aws-blocks/scripts/server.ts",
    "dev": "tsx watch aws-blocks/scripts/server.ts",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "prebuild": "blocks-generate-client",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "secret": "tsx aws-blocks/scripts/secret.ts",
    "typegen": "tsx aws-blocks/scripts/typegen.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "test:e2e": "tsx -C browser test/e2e.test.ts",
    "vendorize": "blocks-vendorize"
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "@aws-blocks/hosting": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  }
}
