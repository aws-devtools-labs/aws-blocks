{
  "name": "blocks-react-app",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "react",
  "blocksTemplateDescription": "Vite + React 19 frontend with auth, DynamoDB, and realtime todo app",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "spec": "blocks generate spec",
    "dev:server": "blocks dev",
    "dev": "blocks dev",
    "dev:stop": "blocks dev stop",
    "sandbox": "blocks sandbox",
    "sandbox:deploy": "blocks sandbox deploy",
    "sandbox:destroy": "blocks sandbox destroy",
    "sandbox:console": "blocks sandbox console",
    "cleanup": "blocks dev stop --all",
    "prebuild": "blocks-generate-client",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "blocks deploy",
    "secret": "blocks secret",
    "typegen": "blocks generate types",
    "destroy": "blocks destroy",
    "test:e2e": "tsx -C browser test/e2e.test.ts",
    "vendorize": "blocks vendorize"
  },
  "blocks": {
    "dev": {
      "frontendCommand": "npx vite --port 3100 --strictPort",
      "frontendPort": 3100
    }
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "@aws-blocks/hosting": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  }
}
