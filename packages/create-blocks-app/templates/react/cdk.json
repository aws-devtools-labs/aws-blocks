{
  "app": "npx tsx -C cdk aws-blocks/index.cdk.ts",
  "context": {
    "@aws-blocks/bb-data:encryptStorageByDefault": true,
    "@aws-blocks/core:mergeExecutionRolePolicies": true
  },
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "node_modules/**",
      ".blocks-sandbox/**",
      "dist/**"
    ]
  }
}
