{
  "name": "blocks-nextjs-app",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "nextjs",
  "blocksTemplateDescription": "Next.js 16 App Router with Server + Client Components calling Blocks",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "spec": "blocks generate spec",
    "dev:server": "blocks dev",
    "dev": "blocks dev",
    "dev:stop": "blocks dev stop",
    "sandbox": "blocks sandbox",
    "sandbox:deploy": "blocks sandbox deploy",
    "sandbox:destroy": "blocks sandbox destroy",
    "sandbox:console": "blocks sandbox console",
    "cleanup": "blocks dev stop --all",
    "prebuild": "blocks-generate-client",
    "build": "next build",
    "start": "next start",
    "deploy": "blocks deploy",
    "destroy": "blocks destroy",
    "secret": "blocks secret",
    "typegen": "blocks generate types",
    "test:e2e": "tsx -C browser test/e2e.test.ts",
    "vendorize": "blocks vendorize"
  },
  "blocks": {
    "dev": {
      "frontendCommand": "npx next dev --webpack --hostname 127.0.0.1 --port 3100",
      "frontendPort": 3100
    }
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "@aws-blocks/hosting": "*",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/aws": "~4.0.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  }
}
