{
  "name": "blocks-nextjs-app",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "nextjs",
  "blocksTemplateDescription": "Next.js 16 App Router with Server + Client Components calling Blocks",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "spec": "cdk-blocks generate spec",
    "dev:server": "cdk-blocks dev",
    "dev": "cdk-blocks dev",
    "dev:stop": "cdk-blocks dev stop",
    "sandbox": "cdk-blocks sandbox",
    "sandbox:deploy": "cdk-blocks sandbox deploy",
    "sandbox:preview": "cdk-blocks sandbox preview",
    "sandbox:destroy": "cdk-blocks sandbox destroy",
    "sandbox:console": "cdk-blocks sandbox console",
    "cleanup": "cdk-blocks dev stop --all",
    "prebuild": "cdk-blocks generate client",
    "build": "next build",
    "start": "next start",
    "deploy": "cdk-blocks deploy",
    "destroy": "cdk-blocks destroy",
    "secret": "cdk-blocks secret",
    "config": "cdk-blocks config",
    "typegen": "cdk-blocks generate types",
    "test:e2e": "tsx -C browser --test-force-exit test/e2e.test.ts",
    "vendorize": "cdk-blocks vendorize"
  },
  "blocks": {
    "dev": {
      "frontendPort": 3100
    }
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "@aws-blocks/hosting": "*",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/aws": "~4.1.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  }
}
