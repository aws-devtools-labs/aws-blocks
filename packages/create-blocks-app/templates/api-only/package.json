{
  "name": "blocks-api-only-app",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "api-only",
  "blocksTemplateDescription": "Headless JSON API service \u2014 public health check + auth-gated CRUD, no frontend (build for a mobile/CLI/3rd-party client)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "spec": "blocks generate spec",
    "prebuild": "blocks-generate-client",
    "dev": "blocks dev",
    "dev:stop": "blocks dev stop",
    "sandbox": "blocks sandbox",
    "sandbox:deploy": "blocks sandbox deploy",
    "sandbox:destroy": "blocks sandbox destroy",
    "sandbox:console": "blocks sandbox console",
    "cleanup": "blocks dev stop --all",
    "deploy": "blocks deploy",
    "secret": "blocks secret",
    "typegen": "blocks generate types",
    "destroy": "blocks destroy",
    "test:e2e": "tsx -C browser test/e2e.test.ts",
    "vendorize": "blocks vendorize"
  },
  "blocks": {
    "dev": {
      "port": 3001
    }
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "2.274.0",
    "constructs": "^10.8.1"
  }
}
