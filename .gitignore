node_modules
packages/*/node_modules
dist
packages/*/dist
packages/admin-ui/.next
# Generated by scripts/generate-block-catalog.mjs on admin-ui's prebuild, from
# the vendorize map and the package READMEs. Committing it would put generated
# code under the linter and let it drift from packages/.
packages/admin-ui/src/server/block-catalog.generated.ts

*.tsbuildinfo
*.swp
*.DS_Store
blocks-demo-app/
blocks-demo-apps/
demos/

.vscode
.idea
.claude

dist-registry/

# Harbor benchmark runtime (raw sessions may contain credentials; never commit).
.harbor-bench/
scripts/harbor-bench/**/__pycache__/

# Generated client code (hosting apps commit theirs for CI)
test-apps/comprehensive/cdk-blocks/client.js
test-apps/telemetry/cdk-blocks/client.js

# CDK
cdk.out
cdk.context.json

# Upgrade-in-place fixture app, materialized per run by test-apps/comprehensive/test/upgrade-in-place.ts
test-apps/.upgrade-in-place/

# Sandbox deploy artifacts (per-deploy state, account-specific)
.cdk-blocks-sandbox/
# The pre-rename name: the migration copies state forward, so an upgraded checkout
# still has this directory and its account-specific contents (D-031).
.blocks-sandbox/
# ... except the Next.js route directory, whose name is the public URL path the
# config is served at, not a state directory. Must come AFTER both ignores above:
# the last matching pattern wins, so earlier placement lets them re-ignore it and
# the template's route silently stops being committed.
!/packages/create-blocks-app/templates/*/src/app/.blocks-sandbox/

# Per-project telemetry/config state (auto-generated, contains UUIDs)
.cdk-blocks/
# ... except each test app's committed config.json, which pins its e2e projectId.
!test-apps/**/.cdk-blocks/
# The data stays out of git by a rule here as well as the runtime marker, as the
# templates do: re-including the directory above un-ignores everything under it.
test-apps/**/.cdk-blocks/local/
!test-apps/**/.cdk-blocks/config.json

# generated docs artifacts
docs/tech-design-output
docs/offline-drafts

# Local workspace scratch files
*.local.md

# Building Block local dev data
.bb-data/
.bb-data-*/

# Local dev artifacts
conversation.md
**/error_e2e_*.txt
**/error_hosting.txt

# Kiro CLI
.kiro/

# PR review output
.bar-raising-pr-reviews/

# Script cache
.cache/
**/.bb-data-*/

# Amplify Hosting build output
test-apps/**/.amplify-hosting/

# Playwright test results
test-apps/**/test-results/
# Swift package build artefacts
.build/

# Auto-generated version files (build-time)
packages/*/src/version.ts
# README snippets as a compile test (build-time, from packages/bb-kv-store/README.md)
packages/bb-kv-store/src/readme.generated.test.ts

# RFC drafts (personal working docs)
docs/tech-design/telemetry-rfc.md

my-test/

# SSR test-app build artefacts (Nuxt/Nitro and Playwright)
test-apps/**/.nuxt/
test-apps/**/.output/
test-apps/**/playwright-report/
test-apps/**/server/plugins/_amplify-cache.mjs

*.log
test-apps/telemetry-test/

# API Extractor temp files (working artifacts, not committed)
packages/*/temp/

# API Extractor intermediate report (generated, only API.md is committed)
*.api.md

# Generated block docs (build artifact; shipped via npm "files", regenerated by prebuild)
packages/blocks/docs/

# Agent-bench local output/scratch artifacts (never committed)
.bench-inv/
bench-variance*/

# Redundant nested npm lockfiles. The root package-lock.json is the single
# source of truth for the workspace (test-apps/native-bindings is a workspace
# member installed by the root `npm ci`); the native example/demo apps are not
# installed in CI via their own lockfiles. Committing these only fragmented the
# dependency graph and produced duplicate Dependabot alerts.
test-apps/native-bindings/package-lock.json
native/kotlin/example/typescript/package-lock.json
native/swift/Demo/typescript-demo/package-lock.json
*.diff

# Local multi-agent orchestration handoff notes (not for the repo)
.sisyphus/

# Per-run fixture of packages/core/src/cdk/lambda-code.test.ts (removed after the run)
.lambda-code-fixture.*/
