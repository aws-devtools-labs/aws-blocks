{
  "name": "typescript-demo",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "demo",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch cdk-blocks/scripts/server.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "sandbox": "tsx cdk-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk cdk-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx cdk-blocks/scripts/console.ts",
    "cleanup": "tsx cdk-blocks/scripts/cleanup.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "tsx cdk-blocks/scripts/deploy.ts",
    "destroy": "tsx cdk-blocks/scripts/destroy.ts",
    "test": "npm run typecheck && npm run test:e2e",
    "test:e2e": "tsx -C browser test/e2e.test.ts",
    "docs": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- docs",
    "docs:search": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- docs --search",
    "docs:api": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- docs --api",
    "spec": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- generate spec",
    "vendorize": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- vendorize",
    "db": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- db",
    "whoami": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- whoami",
    "migrate": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- migrate",
    "help": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- help",
    "generate-client": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- generate client"
  },
  "dependencies": {
    "aws-cdk-blocks": "*",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "aws-cdk-lib": "^2.260.0",
    "concurrently": "^8.2.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@aws-cdk-blocks/core": "0.27.1",
    "postcss": "^8.5.10",
    "brace-expansion": "^5.0.7"
  }
}
