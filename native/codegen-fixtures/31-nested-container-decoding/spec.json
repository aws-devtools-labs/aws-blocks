{
  "openrpc": "1.3.2",
  "info": { "title": "test", "version": "1.0.0" },
  "methods": [
    {
      "name": "api.getBoard",
      "params": [],
      "result": {
        "name": "GetBoardResult",
        "schema": { "$ref": "#/components/schemas/Board" }
      }
    },
    {
      "name": "api.saveLayout",
      "params": [
        { "name": "layout", "required": true, "schema": { "$ref": "#/components/schemas/Layout" } }
      ],
      "result": {
        "name": "SaveLayoutResult",
        "schema": { "$ref": "#/components/schemas/Layout" }
      }
    },
    {
      "name": "api.groupNotes",
      "params": [
        {
          "name": "groups",
          "required": true,
          "schema": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } }
          }
        },
        {
          "name": "levels",
          "required": false,
          "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Level" } }
        }
      ],
      "result": {
        "name": "GroupNotesResult",
        "schema": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } }
        }
      }
    },
    {
      "name": "api.listFeeds",
      "params": [],
      "result": {
        "name": "ListFeedsResult",
        "schema": {
          "type": "array",
          "items": {
            "x-blocks-transferable": "realtime/channel",
            "x-blocks-type-args": [{ "$ref": "#/components/schemas/Note" }]
          }
        }
      }
    },
    {
      "name": "api.getLoginMenu",
      "params": [],
      "result": {
        "name": "GetLoginMenuResult",
        "schema": { "$ref": "#/components/schemas/LoginMenu" }
      }
    }
  ],
  "components": {
    "schemas": {
      "Level": { "type": "string", "enum": ["low", "high"] },
      "Note": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "body": { "type": "string" }
        },
        "required": ["id", "body"]
      },
      "Layout": {
        "type": "object",
        "properties": {
          "tagsByUser": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          },
          "scoresByUser": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "integer" } }
          },
          "notesByTag": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } }
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": { "$ref": "#/components/schemas/Note" }
            }
          },
          "grid": {
            "type": "array",
            "items": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } }
          },
          "matrix": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "integer" } }
          },
          "levels": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Level" }
          },
          "levelsByUser": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "$ref": "#/components/schemas/Level" } }
          },
          "nestedLevels": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": { "$ref": "#/components/schemas/Level" }
            }
          },
          "maybeNotes": {
            "type": "array",
            "items": {
              "oneOf": [{ "$ref": "#/components/schemas/Note" }, { "type": "null" }]
            }
          }
        },
        "required": ["tagsByUser", "notesByTag", "pages", "grid", "matrix", "levels", "nestedLevels", "maybeNotes"]
      },
      "Board": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "channels": {
            "type": "array",
            "items": {
              "x-blocks-transferable": "realtime/channel",
              "x-blocks-type-args": [{ "$ref": "#/components/schemas/Note" }]
            }
          },
          "tagFeeds": {
            "type": "array",
            "items": {
              "x-blocks-transferable": "realtime/channel",
              "x-blocks-type-args": [{ "type": "array", "items": { "type": "string" } }]
            }
          },
          "feedsByRoom": {
            "type": "object",
            "additionalProperties": {
              "x-blocks-transferable": "realtime/channel",
              "x-blocks-type-args": [{ "$ref": "#/components/schemas/Note" }]
            }
          },
          "downloads": {
            "type": "array",
            "items": { "x-blocks-transferable": "file-bucket/download" }
          },
          "layout": { "$ref": "#/components/schemas/Layout" }
        },
        "required": ["title", "channels", "feedsByRoom", "downloads", "layout"]
      },
      "SignInOption": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "client": { "x-blocks-transferable": "oidc/client" }
        },
        "required": ["label", "client"]
      },
      "LoginMenu": {
        "type": "object",
        "properties": {
          "primary": { "$ref": "#/components/schemas/SignInOption" },
          "options": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SignInOption" }
          },
          "fallback": { "x-blocks-transferable": "oidc/client" }
        },
        "required": ["primary", "options"]
      }
    }
  }
}
