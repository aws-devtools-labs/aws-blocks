{
  "openrpc": "1.3.2",
  "info": { "title": "test", "version": "1.0.0" },
  "methods": [
    {
      "name": "api.getOptions",
      "params": [
        { "name": "options", "required": true, "schema": { "type": "object" } },
        { "name": "extra", "required": false, "schema": { "type": "object", "properties": {} } }
      ],
      "result": { "name": "GetOptionsResult", "schema": { "type": "object" } }
    },
    {
      "name": "api.getSettings",
      "params": [
        { "name": "settings", "required": true, "schema": { "$ref": "#/components/schemas/Settings" } }
      ],
      "result": { "name": "GetSettingsResult", "schema": { "$ref": "#/components/schemas/Settings" } }
    },
    {
      "name": "api.getEnvelope",
      "params": [],
      "result": {
        "name": "GetEnvelopeResult",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "meta": { "type": "object" },
            "attachments": { "type": "array", "items": { "type": "object" } },
            "settings": { "oneOf": [{ "$ref": "#/components/schemas/Settings" }, { "type": "null" }] }
          },
          "required": ["id", "meta", "attachments"]
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "Settings": { "type": "object" }
    }
  }
