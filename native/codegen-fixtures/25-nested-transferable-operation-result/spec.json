{
  "openrpc": "1.3.2",
  "info": { "title": "test", "version": "1.0.0" },
  "methods": [
    {
      "name": "api.getSession",
      "params": [],
      "result": {
        "name": "GetSessionResult",
        "schema": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "channel": {
              "x-blocks-transferable": "realtime/channel",
              "x-blocks-type-args": [
                {
                  "type": "object",
                  "properties": { "text": { "type": "string" } },
                  "required": ["text"]
                }
              ]
            },
            "inner": {
              "type": "object",
              "properties": {
                "channel": {
                  "x-blocks-transferable": "realtime/channel",
                  "x-blocks-type-args": [
                    {
                      "type": "object",
                      "properties": { "count": { "type": "integer" } },
                      "required": ["count"]
                    }
                  ]
                }
              },
              "required": ["channel"]
            },
            "event": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "enum": ["message"] },
                    "channel": {
                      "x-blocks-transferable": "realtime/channel",
                      "x-blocks-type-args": [
                        {
                          "type": "object",
                          "properties": { "body": { "type": "string" } },
                          "required": ["body"]
                        }
                      ]
                    }
                  },
                  "required": ["kind", "channel"]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "enum": ["presence"] },
                    "channel": {
                      "x-blocks-transferable": "realtime/channel",
                      "x-blocks-type-args": [
                        {
                          "type": "object",
                          "properties": { "online": { "type": "boolean" } },
                          "required": ["online"]
                        }
                      ]
                    }
                  },
                  "required": ["kind", "channel"]
                }
              ]
            },
            "stringValues": {
              "x-blocks-transferable": "realtime/channel",
              "x-blocks-type-args": [
                { "type": "array", "items": { "type": "string" } }
              ]
            },
            "integerValues": {
              "x-blocks-transferable": "realtime/channel",
              "x-blocks-type-args": [
                { "type": "array", "items": { "type": "integer" } }
              ]
            }
          },
          "required": ["sessionId", "channel", "inner", "event", "stringValues", "integerValues"]
        }
      }
    },
    {
      "name": "api.getOtherSession",
      "params": [],
      "result": {
        "name": "GetOtherSessionResult",
        "schema": {
          "type": "object",
          "properties": {
            "channel": {
              "x-blocks-transferable": "realtime/channel",
              "x-blocks-type-args": [
                {
                  "type": "object",
                  "properties": { "count": { "type": "integer" } },
                  "required": ["count"]
                }
              ]
            }
          },
          "required": ["channel"]
        }
      }
    }
  ]
}
