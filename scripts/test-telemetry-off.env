# Loaded by the unit test scripts (`node --env-file=...`) so tests that run the
# real CLI, its bins or core's tracked entry points send no usage events: a
# local run has no CI marker, so its events would otherwise count as real usage.
# Tests that check telemetry delete this variable themselves. A value already in
# the environment wins over this file.
CDK_DISABLE_CLI_TELEMETRY=1
