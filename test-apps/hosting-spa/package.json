{
  "name": "bb-test-hosting-spa",
  "version": "0.1.0",
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "E2E test app for AWS CDK Blocks Hosting — SPA (static site) deployment",
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "dev:server": "tsx cdk-blocks/scripts/server.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "test": "tsx --test test-lifecycle/sandbox-lifecycle.test.ts",
    "test:local": "BLOCKS_TEST_ENV=local npx playwright test",
    "test:sandbox": "BLOCKS_TEST_ENV=sandbox npx playwright test",
    "test:e2e:local": "npm run test:local",
    "test:e2e:sandbox": "npm run test:sandbox",
    "vendorize": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- vendorize"
  },
  "dependencies": {
    "@aws-cdk-blocks/bb-auth": "1.0.0",
    "aws-cdk-blocks": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "vite": "^6.4.5",
    "concurrently": "^8.2.2",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "@playwright/test": "^1.64.1"
  }
}
