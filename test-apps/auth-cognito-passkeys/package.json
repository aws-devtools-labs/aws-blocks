{
  "name": "bb-test-auth-cognito-passkeys",
  "version": "0.1.0",
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Manual test app for AuthCognito passkey (WebAuthn) sign-in + management.",
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch aws-blocks/scripts/server.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "build": "tsc && vite build",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "tsx": "^4.23.12",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "aws-cdk-lib": "2.257.0",
    "constructs": "^10.6.0"
  }
}
