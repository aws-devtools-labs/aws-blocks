{
  "name": "bb-test-auth-cognito-passkeys",
  "version": "0.1.0",
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Manual test app for Auth passkey (WebAuthn) sign-in + management.",
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch cdk-blocks/scripts/server.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "sandbox": "tsx cdk-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk cdk-blocks/scripts/sandbox-destroy.ts",
    "build": "tsc && vite build",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@aws-cdk-blocks/bb-auth": "1.0.0",
    "aws-cdk-blocks": "1.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "tsx": "^4.23.15",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1"
  }
}
