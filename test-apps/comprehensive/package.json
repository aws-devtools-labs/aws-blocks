{
  "name": "bb-test-comprehensive",
  "version": "0.2.5",
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Comprehensive test application for AWS CDK Blocks - covers all Building Blocks",
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "dev:server": "tsx cdk-blocks/scripts/server.ts",
    "dev": "tsx cdk-blocks/scripts/server.ts",
    "test": "tsx --test test/upgrade-in-place/lib.test.ts test/test-support-synth.test.ts test/test-support-secret.test.ts",
    "destroy": "tsx cdk-blocks/scripts/destroy.ts",
    "test:local": "BLOCKS_TEST_ENV=local tsx -C browser test/e2e.test.ts",
    "test:sandbox": "BLOCKS_TEST_ENV=sandbox tsx -C browser test/e2e.test.ts",
    "test:production": "BLOCKS_TEST_ENV=production tsx -C browser test/e2e.test.ts",
    "test:e2e:local": "npm run test:local",
    "test:e2e:sandbox": "npm run test:sandbox",
    "test:e2e:production": "npm run test:production",
    "test:upgrade-in-place": "tsx test/upgrade-in-place.ts",
    "test:upgrade-in-place:dry-run": "tsx test/upgrade-in-place.ts --dry-run",
    "test:upgrade-legacy-kv-store": "tsx test/upgrade-legacy-kv-store.ts",
    "test:upgrade-sql-blocks": "tsx test/upgrade-sql-blocks.ts",
    "db": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- db",
    "vendorize": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- vendorize"
  },
  "dependencies": {
    "@aws-cdk-blocks/auth-common": "1.0.0",
    "@aws-cdk-blocks/bb-agent": "1.0.0",
    "@aws-cdk-blocks/bb-app-setting": "1.0.0",
    "@aws-cdk-blocks/bb-async-job": "1.0.0",
    "@aws-cdk-blocks/bb-auth": "1.0.0",
    "@aws-cdk-blocks/bb-cron-job": "1.0.0",
    "@aws-cdk-blocks/bb-dashboard": "1.0.0",
    "@aws-cdk-blocks/bb-database": "1.0.0",
    "@aws-cdk-blocks/bb-email-client": "1.0.0",
    "@aws-cdk-blocks/bb-file-bucket": "1.0.0",
    "@aws-cdk-blocks/bb-knowledge-base": "1.0.0",
    "@aws-cdk-blocks/bb-kv-store": "1.0.0",
    "@aws-cdk-blocks/bb-logger": "1.0.0",
    "@aws-cdk-blocks/bb-metrics": "1.0.0",
    "@aws-cdk-blocks/bb-realtime": "1.0.0",
    "@aws-cdk-blocks/bb-secret": "1.0.0",
    "@aws-cdk-blocks/bb-tracer": "1.0.0",
    "aws-cdk-blocks": "1.0.0",
    "@aws-cdk-blocks/core": "1.0.0",
    "kysely": "^0.29.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudformation": "^3.1156.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@smithy/signature-v4": "^5.7.5",
    "@types/node": "^20.19.43",
    "aws-cdk-lib": "^2.274.0",
    "concurrently": "^8.2.2",
    "constructs": "^10.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
