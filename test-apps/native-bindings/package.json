{
  "name": "bb-test-native-bindings",
  "version": "0.1.0",
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Test backend for native client bindings (Swift, Kotlin, Dart) — exercises auth, realtime, file, and KV blocks",
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "spec": "tsx cdk-blocks/scripts/generate-spec.ts",
    "test": "echo 'E2E tests run via the native-sdk-e2e workflow (deploy + Dart suite)'",
    "dev:server": "tsx watch cdk-blocks/scripts/server.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "sandbox": "tsx cdk-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk cdk-blocks/scripts/sandbox-destroy.ts",
    "cleanup": "tsx cdk-blocks/scripts/cleanup.ts",
    "preview": "vite preview",
    "deploy": "npm run deploy:sandbox",
    "deploy:sandbox": "tsx cdk-blocks/scripts/deploy-sandbox.ts",
    "destroy": "npm run sandbox:destroy",
    "seed:cognito": "tsx cdk-blocks/scripts/seed-cognito-user.ts",
    "vendorize": "node --input-type=module -e \"import 'aws-cdk-blocks/run'\" -- vendorize"
  },
  "dependencies": {
    "@aws-cdk-blocks/bb-auth": "1.0.0",
    "aws-cdk-blocks": "1.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "tsx": "^4.23.15",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1"
  }
}
